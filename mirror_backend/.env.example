# Copy to .env, which git ignores. Never commit real values.

# Your OpenAI API key. It stays on this server and never goes into the app.
OPENAI_API_KEY=

# Paid image generation stays off until this is exactly true.
WADROVA_LIVE_INFERENCE=false

# Shared secret the app must send. Generate one with: openssl rand -hex 32
WADROVA_DEV_TOKEN=

# gpt-image-2.5-sunburst is the default; gpt-image-2.5-flare is the alternative.
WADROVA_IMAGE_MODEL=gpt-image-2.5-sunburst
WADROVA_IMAGE_QUALITY=high

# Seconds to wait for OpenAI before failing a request.
WADROVA_REQUEST_TIMEOUT_SECONDS=240
