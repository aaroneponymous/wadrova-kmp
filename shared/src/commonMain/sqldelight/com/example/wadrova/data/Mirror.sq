-- Approved personal models. Each approval adds a version, so earlier results keep a valid reference.
CREATE TABLE mirror_model (
    model_id TEXT NOT NULL,
    version INTEGER NOT NULL,
    image_id TEXT NOT NULL,
    generation_model TEXT NOT NULL,
    generation_quality TEXT NOT NULL,
    approved_at INTEGER NOT NULL,
    PRIMARY KEY (model_id, version)
);

-- Accepted try-on previews. Images live in app-private files, not in this database.
CREATE TABLE try_on_result (
    id TEXT NOT NULL PRIMARY KEY,
    model_id TEXT NOT NULL,
    model_version INTEGER NOT NULL,
    garment_id TEXT NOT NULL,
    source_image_id TEXT NOT NULL,
    source_image_kind TEXT NOT NULL,
    generation_model TEXT NOT NULL,
    generation_quality TEXT NOT NULL,
    result_image_id TEXT NOT NULL,
    created_at INTEGER NOT NULL
);

CREATE TABLE app_setting (
    key TEXT NOT NULL PRIMARY KEY,
    value TEXT NOT NULL
);

selectLatestModel:
SELECT * FROM mirror_model ORDER BY version DESC LIMIT 1;

insertModel:
INSERT INTO mirror_model (model_id, version, image_id, generation_model, generation_quality, approved_at)
VALUES (?, ?, ?, ?, ?, ?);

selectModelImageIds:
SELECT image_id FROM mirror_model;

deleteAllModels:
DELETE FROM mirror_model;

selectTryOns:
SELECT * FROM try_on_result ORDER BY created_at DESC, id;

selectTryOn:
SELECT * FROM try_on_result WHERE id = ?;

insertTryOn:
INSERT INTO try_on_result (id, model_id, model_version, garment_id, source_image_id, source_image_kind, generation_model, generation_quality, result_image_id, created_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteTryOn:
DELETE FROM try_on_result WHERE id = ?;

deleteAllTryOns:
DELETE FROM try_on_result;

selectTryOnImageIds:
SELECT result_image_id FROM try_on_result;

selectSetting:
SELECT value FROM app_setting WHERE key = ?;

upsertSetting:
INSERT OR REPLACE INTO app_setting (key, value) VALUES (?, ?);

deleteSetting:
DELETE FROM app_setting WHERE key = ?;
