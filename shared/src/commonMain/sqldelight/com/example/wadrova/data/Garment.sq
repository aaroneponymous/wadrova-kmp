-- The user's garments: the only garments the app has.
CREATE TABLE user_garment (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    category TEXT NOT NULL,
    color TEXT NOT NULL,
    brand TEXT,
    material TEXT,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    archived_at INTEGER,
    photo_id TEXT,
    extracted_image_id TEXT,
    -- An imported garment's transparent cutout (a generated-image id). photo_id stays its flattened JPEG.
    cutout_image_id TEXT
);

selectGarments:
SELECT * FROM user_garment ORDER BY created_at DESC, id;

selectGarment:
SELECT * FROM user_garment WHERE id = ?;

selectGarmentCategories:
SELECT id, category FROM user_garment;

countLooksUsingGarment:
SELECT COUNT(*) FROM saved_look_garment WHERE garment_id = ?;

insertGarment:
INSERT INTO user_garment (id, name, category, color, brand, material, created_at, updated_at, archived_at, photo_id, extracted_image_id, cutout_image_id)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, NULL, ?, NULL, NULL);

-- A garment saved from an import review, with its transparent cutout when one was kept.
insertImportedGarment:
INSERT INTO user_garment (id, name, category, color, brand, material, created_at, updated_at, archived_at, photo_id, extracted_image_id, cutout_image_id)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, NULL, ?, NULL, ?);

updateGarment:
UPDATE user_garment SET name = ?, category = ?, color = ?, brand = ?, material = ?, photo_id = ?, extracted_image_id = ?, cutout_image_id = ?, updated_at = ? WHERE id = ?;

setExtractedImage:
UPDATE user_garment SET extracted_image_id = ?, updated_at = ? WHERE id = ?;

selectExtractedImageIds:
SELECT extracted_image_id FROM user_garment WHERE extracted_image_id IS NOT NULL;

selectCutoutImageIds:
SELECT cutout_image_id FROM user_garment WHERE cutout_image_id IS NOT NULL;

selectPhotoIds:
SELECT photo_id FROM user_garment WHERE photo_id IS NOT NULL;

setGarmentArchivedAt:
UPDATE user_garment SET archived_at = ?, updated_at = ? WHERE id = ?;
